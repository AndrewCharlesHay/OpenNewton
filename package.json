{
  "name": "opennewton",
  "displayName": "OpenNewton",
  "description": "Monitors GitHub Actions workflows and notifies about failures",
  "version": "0.2.2",
  "publisher": "AndrewCharlesHay",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewCharlesHay/OpenNewton"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "opennewton.checkStatus",
        "title": "OpenNewton: Check Status"
      },

      {
        "command": "opennewton.showFailures",
        "title": "OpenNewton: Show Recent Failures"
      }
    ],
    "configuration": {
      "title": "OpenNewton",
      "properties": {

        "openNewton.pollInterval": {
          "type": "number",
          "default": 300,
          "description": "Polling interval in seconds (default: 300)"
        },
        "openNewton.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic monitoring"
        },
        "openNewton.notifyOnFailure": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when workflows fail"
        },
        "openNewton.chatCommand": {
          "type": "string",
          "default": "workbench.action.chat.open",
          "description": "Command to execute when a failure is detected (e.g. 'workbench.action.chat.open')"
        },
        "openNewton.logFormat": {
          "type": "string",
          "enum": [
            "text",
            "json"
          ],
          "default": "text",
          "description": "Format for output channel logs"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "20.x",
    "@types/mocha": "^10.0.1",
    "@types/sinon": "^10.0.16",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "^8.47.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "sinon": "^15.2.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2"
  }
}
